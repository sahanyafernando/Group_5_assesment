APP_NAME=Muthuwella Works Dispatch API
APP_ENV=development

# true  = serve built-in demo incidents, no Supabase needed
# false = read live data from Supabase
DEMO_MODE=true

CORS_ORIGINS=http://localhost:5173

# Supabase — BACKEND ONLY, never put these in frontend/.env
SUPABASE_URL=
# Server-side secret key (Supabase dashboard: Project Settings / API Keys).
# SUPABASE_KEY and SUPABASE_SERVICE_ROLE_KEY are also accepted as aliases.
# Do NOT use the publishable/anon key: RLS is on with no public policies,
# so it would read zero rows.
SUPABASE_SECRET_KEY=

# Claude — BACKEND ONLY
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
